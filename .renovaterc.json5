{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#12.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#12.0.0",
    ":semanticCommits",
    ":timezone(Europe/Brussels)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard",
  ignorePaths: ["**/archive/**"],
  flux: {
    managerFilePatterns: ["/kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/kubernetes/.+/helm/values\\.ya?ml$/", "/kubernetes/.+/helmrelease\\.ya?ml$/"],
  },
  helmfile: {
    // bootstrap/helmfile.yaml.gotmpl reads its versions from the OCIRepositories
    enabled: false,
  },
  kubernetes: {
    managerFilePatterns: ["/kubernetes/.+\\.ya?ml$/"],
  },
  // Without this, automerge forces rebaseWhen=behind-base-branch: Renovate then merges only one PR
  // per run (each merge puts the others behind main) and the PRs pile up. Version bumps touch one
  // line, so CI on a slightly older main is fine. PRs still get rebased when they conflict.
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: "Automerge minor, patch and digest updates of everything once CI is green (0.x is excluded: there a minor bump may break)",
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchCurrentVersion: "!/^v?0/",
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "0.x patch updates are safe to automerge too",
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "/^v?0/",
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Never automerge Talos or Kubernetes - they need `task talos:upgrade-*`",
      matchPackageNames: ["/siderolabs/", "/kubernetes/kubernetes/"],
      automerge: false,
    },
    {
      description: "talosctl (.mise.toml) moves with the cluster's Talos version (talos/talenv.yaml)",
      matchPackageNames: ["/siderolabs/talos/", "/siderolabs/installer/"],
      groupName: "talos",
    },
    {
      description: "kubectl (.mise.toml) moves with the cluster's Kubernetes version (talos/talenv.yaml)",
      matchPackageNames: ["/kubernetes/kubernetes/", "/siderolabs/kubelet/"],
      groupName: "kubernetes",
    },
    {
      description: "Group Flux operator and instance charts",
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      groupName: "flux-operator",
    },
    {
      description: "Prowlarr 3.x is still pre-release (the image tags don't say so). Remove once v3 is marked stable on GitHub",
      matchPackageNames: ["ghcr.io/home-operations/prowlarr"],
      allowedVersions: "<3",
    },
    {
      description: "Immich: server and machine-learning move together",
      matchPackageNames: ["/immich/"],
      groupName: "immich",
      automerge: false,
    },
  ],
}
