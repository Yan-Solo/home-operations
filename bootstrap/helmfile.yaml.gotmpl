# yaml-language-server: $schema=https://json.schemastore.org/helmfile
#
# Only what Flux needs to start. Flux takes over these exact releases afterwards
# (same names, same values files), so there is a single source of truth.
# Chart URLs and versions are read from each app's ocirepository.yaml, so Renovate
# only has to bump those.
helmDefaults:
  cleanupOnFail: true
  wait: true
  waitForJobs: true
  timeout: 600

releases:
  - name: prometheus-operator-crds
    namespace: kube-system
    {{- $crds := readFile "../kubernetes/apps/kube-system/prometheus-operator-crds/app/ocirepository.yaml" | fromYaml }}
    chart: {{ $crds.spec.url }}
    version: {{ $crds.spec.ref.tag }}

  - name: cilium
    namespace: kube-system
    {{- $cilium := readFile "../kubernetes/apps/kube-system/cilium/app/ocirepository.yaml" | fromYaml }}
    chart: {{ $cilium.spec.url }}
    version: {{ $cilium.spec.ref.tag }}
    values:
      - "../kubernetes/apps/kube-system/cilium/app/helm/values.yaml"
      # Hubble Relay and UI only turn Ready once they can resolve names, and CoreDNS is
      # installed after Cilium. Flux enables them as soon as CoreDNS is running.
      - hubble:
          relay:
            enabled: false
          ui:
            enabled: false
    needs: ["kube-system/prometheus-operator-crds"]

  - name: coredns
    namespace: kube-system
    {{- $coredns := readFile "../kubernetes/apps/kube-system/coredns/app/ocirepository.yaml" | fromYaml }}
    chart: {{ $coredns.spec.url }}
    version: {{ $coredns.spec.ref.tag }}
    values: ["../kubernetes/apps/kube-system/coredns/app/helm/values.yaml"]
    needs: ["kube-system/cilium"]

  - name: flux-operator
    namespace: flux-system
    {{- $operator := readFile "../kubernetes/apps/flux-system/flux-operator/app/ocirepository.yaml" | fromYaml }}
    chart: {{ $operator.spec.url }}
    version: {{ $operator.spec.ref.tag }}
    values:
      - "../kubernetes/apps/flux-system/flux-operator/app/helm/values.yaml"
      # The web UI needs the Gateway API CRDs and its OIDC secret, which don't exist yet.
      # Flux enables it as soon as Envoy Gateway and External Secrets are running.
      - web:
          enabled: false
    needs: ["kube-system/coredns"]

  - name: flux-instance
    namespace: flux-system
    {{- $instance := readFile "../kubernetes/apps/flux-system/flux-instance/app/ocirepository.yaml" | fromYaml }}
    chart: {{ $instance.spec.url }}
    version: {{ $instance.spec.ref.tag }}
    values: ["../kubernetes/apps/flux-system/flux-instance/app/helm/values.yaml"]
    needs: ["flux-system/flux-operator"]
