# Copy to .env (gitignored). mise loads it automatically.
# Machine account token for the "workstation" machine account in Bitwarden Secrets Manager
BWS_ACCESS_TOKEN=
# Machine account token for the "cluster" machine account (gets copied into the cluster during bootstrap)
BWS_CLUSTER_ACCESS_TOKEN=
# The Secrets Manager project that holds every home-operations secret
BWS_PROJECT_ID=
# Only if your account lives on bitwarden.eu (you log in at vault.bitwarden.eu)
# BWS_SERVER_URL=https://vault.bitwarden.eu
