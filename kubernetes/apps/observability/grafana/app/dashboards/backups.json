    {
      "type": "timeseries",
      "title": "Backup age per volume",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Should drop to ~0 every night. A line that keeps climbing past the orange band is a volume that stopped backing up.",
      "gridPos": {
        "h": 13,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(time() - volsync_replicationsource_last_sync_timestamp_seconds, \"app\", \"$1\", \"name\", \"(.*)\"))",
          "legendFormat": "{{namespace}}/{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 93600
              },
              {
                "color": "#F2495C",
                "value": 180000
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "linear",
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed+area"
            },
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "state-timeline",
