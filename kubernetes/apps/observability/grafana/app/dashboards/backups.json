    {
      "type": "table",
      "title": "Volumes",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Sorted by oldest backup first.",
      "gridPos": {
        "h": 13,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(time() - volsync_replicationsource_last_sync_timestamp_seconds, \"app\", \"$1\", \"name\", \"(.*)\"))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(volsync_replicationsource_latest_mover_result{result=\"Successful\"}, \"app\", \"$1\", \"name\", \"(.*)\"))",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(label_replace(volsync_volume_out_of_sync{role=\"source\"}, \"app\", \"$1\", \"obj_name\", \"(.*)\"), \"namespace\", \"$1\", \"obj_namespace\", \"(.*)\"))",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(label_replace(round(increase(volsync_missed_intervals_total{role=\"source\"}[7d])) and volsync_missed_intervals_total{role=\"source\"}, \"app\", \"$1\", \"obj_name\", \"(.*)\"), \"namespace\", \"$1\", \"obj_namespace\", \"(.*)\"))",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (namespace, app) (label_replace(volsync_replicationsource_next_sync_timestamp_seconds - time(), \"app\", \"$1\", \"name\", \"(.*)\"))",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "app": "Volume",
              "Value #A": "Last backup",
              "Value #B": "Last run",
              "Value #C": "Sync state",
              "Value #D": "Missed (7d)",
              "Value #E": "Next backup in"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last backup",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last backup"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#73BF69",
                      "value": null
                    },
                    {
                      "color": "#FF9830",
                      "value": 93600
                    },
                    {
                      "color": "#F2495C",
                      "value": 180000
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#F2495C",
                      "value": null
                    },
                    {
                      "color": "#73BF69",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Successful",
                        "color": "#73BF69",
                        "index": 0
                      },
                      "0": {
                        "text": "Failed",
                        "color": "#F2495C",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sync state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#73BF69",
                      "value": null
                    },
                    {
                      "color": "#F2495C",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "In sync",
                        "color": "#73BF69",
                        "index": 0
                      },
                      "1": {
                        "text": "Out of sync",
                        "color": "#F2495C",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Missed (7d)"
